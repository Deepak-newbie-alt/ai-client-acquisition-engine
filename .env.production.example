# Production settings for docker-compose.production.yml. Copy to .env.production
# (never commit it) and keep it readable only by the deploy user (chmod 600).
DOMAIN=ace.example.com
APP_ORIGIN=https://ace.example.com
LOG_LEVEL=info

POSTGRES_USER=ace
# Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=ace
DATABASE_URL=postgresql://ace:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/ace

# Providers stay mock until you deliberately switch them (see README "Real providers").
PAGE_FETCHER=mock
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
EMAIL_PROVIDER=mock
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=
# Optional in production; when set, only these emails/domains can be sent to.
EMAIL_RECIPIENT_ALLOWLIST=

OUTREACH_SENDER_NAME=
OUTREACH_POSTAL_ADDRESS=

RESEARCH_MAX_RESULTS_PER_RUN=20
RESEARCH_RUN_BUDGET_USD=1
MONTHLY_BUDGET_USD=10
APPROVAL_TTL_MINUTES=60
SESSION_TTL_HOURS=12
