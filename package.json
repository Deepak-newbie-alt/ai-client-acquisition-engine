{
  "name": "ai-client-acquisition-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && npm run web:build",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "user:create": "tsx scripts/create-user.ts",
    "token:create": "tsx scripts/create-service-token.ts",
    "token:list": "tsx scripts/service-tokens.ts",
    "token:revoke": "tsx scripts/service-tokens.ts --revoke",
    "providers:smoke": "tsx scripts/provider-smoke.ts",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@googleapis/gmail": "22.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cheerio": "1.2.0",
    "cookie": "2.0.1",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "ipaddr.js": "2.5.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "robots-parser": "3.0.1",
    "tldts": "7.4.19",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
