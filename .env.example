# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Origin of the dashboard; used for CORS and cookie/CSRF checks. Must be https in production.
APP_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (1 behind Caddy/nginx). Leave 0
# when clients connect directly, or they could spoof their IP for rate limits.
TRUST_PROXY=0
# Built dashboard to serve from the API (production). Empty in development (Vite serves it).
WEB_DIST_DIR=

# --- Database (docker compose) ---
POSTGRES_USER=ace
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ace_dev
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ace:change-me-local-only@127.0.0.1:5433/ace_dev
# Used only by the test suite. The database name must end in _test.
TEST_DATABASE_URL=postgresql://ace:change-me-local-only@127.0.0.1:5433/ace_test

# --- Providers: "mock" by default; real providers need explicit keys ---
# mock = built-in fixture pages (offline); http = fetch real public pages
PAGE_FETCHER=mock

SEARCH_PROVIDER=mock
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
# USD per Tavily credit (pay-as-you-go list price; adjust to your plan)
TAVILY_USD_PER_CREDIT=0.008

LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (claude-opus-5-5 defaults to medium)
ANTHROPIC_EFFORT=medium
# Only needed for models without a built-in price (src/integrations/llm/pricing.ts)
ANTHROPIC_INPUT_USD_PER_MTOK=
ANTHROPIC_OUTPUT_USD_PER_MTOK=

EMAIL_PROVIDER=mock
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=
# Comma-separated emails/domains; required with gmail outside production
EMAIL_RECIPIENT_ALLOWLIST=

# --- Outreach footer (sender identity + opt-out line are added to every email) ---
OUTREACH_SENDER_NAME=
OUTREACH_POSTAL_ADDRESS=
SEND_RECONCILE_GRACE_MINUTES=15

# --- Limits ---
RESEARCH_MAX_RESULTS_PER_RUN=20
RESEARCH_RUN_BUDGET_USD=1
MONTHLY_BUDGET_USD=10
APPROVAL_TTL_MINUTES=60
SESSION_TTL_HOURS=12
